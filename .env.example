# ─────────────────────────────────────────────────────────────
#  neaby — environment
#  Production (Coolify): set these on the Application resource.
#  Postgres and Redis are separate Coolify resources — paste their
#  INTERNAL URLs below. Never commit a real .env.
# ─────────────────────────────────────────────────────────────
APP_NAME=neaby
APP_ENV=production
# php artisan key:generate --show   → paste the base64:... value
APP_KEY=
APP_DEBUG=false
APP_URL=https://neaby.example.com
APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ── Database (Coolify PostgreSQL resource → "Postgres URL (internal)") ──
DB_CONNECTION=pgsql
# Paste the internal URL as DB_URL (or DATABASE_URL), e.g.
# DB_URL=postgres://neaby:secret@postgres-xyz:5432/neaby
# …or use the discrete form below (a URL wins when set):
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=neaby
DB_USERNAME=neaby
DB_PASSWORD=

# ── Redis (Coolify Redis resource → "Redis URL (internal)") ──
REDIS_CLIENT=phpredis
# REDIS_URL=redis://default:secret@redis-xyz:6379/0
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_SECURE_COOKIE=true
# The image runs a queue worker + scheduler (s6). Use redis (or database) in production.
# sync also works (imports then run inside the upload request).
QUEUE_CONNECTION=redis
# false = don't start the in-container worker/scheduler (if you run them elsewhere)
NEABY_RUN_WORKERS=true
NEABY_WORKER_START_DELAY=20

# ── Uploads: VPS disk via the ObjectStore interface ──
# Persist /var/www/html/storage/app/public with a Coolify volume.
FILESYSTEM_DISK=local
NEABY_UPLOAD_DISK=public
NEABY_MAX_IMAGE_KB=8192
NEABY_MAX_IMAGES=8

# ── Admin access: comma-separated usernames (plus users.is_admin flag) ──
ADMIN_USERNAMES=

# ── Moderation: true = new listings go to "pending" for admin review ──
NEABY_REQUIRE_PRODUCT_REVIEW=false
# Seed/refresh default categories on every boot (idempotent)
NEABY_SEED_CATEGORIES=true

# ── AI listing titles (optional; works without a key) ──
# fake = built-in heuristic titles · openai = any OpenAI-compatible API · null = off
LISTING_AI_DRIVER=fake
LISTING_AI_BASE_URL=https://api.openai.com/v1
LISTING_AI_API_KEY=
LISTING_AI_MODEL=gpt-4o-mini

# ── Payments: checkout, memberships, sponsored listings ──
# fake = no money moves (built-in TEST MODE pay page) · monnify = real Monnify checkout
PAYMENT_PROVIDER=fake
# allow the fake pay page (keep false in production once on Monnify)
PAYMENT_FAKE_SANDBOX=true
# Monnify: set all three keys + PAYMENT_PROVIDER=monnify. Live base URL: https://api.monnify.com
# Webhook URL to paste in the Monnify dashboard: ${APP_URL}/webhooks/payments/monnify
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# ── Phase 2–7 feature knobs ──
NEABY_MAIL_NOTIFICATIONS=true
NEABY_CHECKOUT_ENABLED=true
NEABY_RESERVATION_MINUTES=30
NEABY_MAX_QTY_PER_ITEM=20
NEABY_MEMBERSHIP_GRACE_DAYS=3
NEABY_SUPPLIER_REQUEST_EXPIRY_DAYS=7
NEABY_MAX_RESELLER_OFFERS=200
NEABY_SPONSORED_ENABLED=true
# kobo per day (50000 = ₦500/day)
NEABY_SPONSORED_DAILY_PRICE_MINOR=50000
# at most one sponsored card per N feed items
NEABY_SPONSORED_EVERY=8
NEABY_SELLER_PRO_ENABLED=true

# ── Mail (password reset, order / membership / request notices). log = container logs ──
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@neaby.example.com"
MAIL_FROM_NAME="neaby"

BCRYPT_ROUNDS=12
VITE_APP_NAME="${APP_NAME}"
