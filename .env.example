# ─────────────────────────────────────────────────────────────
#  neaby — environment
#  Production (Coolify): set these on the Application resource.
#  Postgres and Redis are separate Coolify resources — paste their
#  INTERNAL URLs below. Never commit a real .env.
# ─────────────────────────────────────────────────────────────
APP_NAME=neaby
APP_ENV=production
# php artisan key:generate --show   → paste the base64:... value
APP_KEY=
APP_DEBUG=false
APP_URL=https://neaby.example.com
APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ── Database (Coolify PostgreSQL resource → "Postgres URL (internal)") ──
DB_CONNECTION=pgsql
# Paste the internal URL as DB_URL (or DATABASE_URL), e.g.
# DB_URL=postgres://neaby:secret@postgres-xyz:5432/neaby
# …or use the discrete form below (a URL wins when set):
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=neaby
DB_USERNAME=neaby
DB_PASSWORD=

# ── Redis (Coolify Redis resource → "Redis URL (internal)") ──
REDIS_CLIENT=phpredis
# REDIS_URL=redis://default:secret@redis-xyz:6379/0
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_SECURE_COOKIE=true
# The image runs a queue worker + scheduler (s6). Use redis (or database) in production.
# sync also works (imports then run inside the upload request).
QUEUE_CONNECTION=redis
# false = don't start the in-container worker/scheduler (if you run them elsewhere)
NEABY_RUN_WORKERS=true
NEABY_WORKER_START_DELAY=20

# ── Uploads: VPS disk via the ObjectStore interface ──
# Persist /var/www/html/storage/app/public with a Coolify volume.
FILESYSTEM_DISK=local
NEABY_UPLOAD_DISK=public
NEABY_MAX_IMAGE_KB=8192
NEABY_MAX_IMAGES=8

# ── Admin access: comma-separated usernames (plus users.is_admin flag) ──
ADMIN_USERNAMES=

# ── Moderation: true = new listings go to "pending" for admin review ──
NEABY_REQUIRE_PRODUCT_REVIEW=false
# Seed/refresh default categories on every boot (idempotent)
NEABY_SEED_CATEGORIES=true
# Demo cast (neaby1@beuden.com.ng … neaby20@, password = the email). Never uses Listing AI credits.
# true = seed on boot (once, idempotent) · wipe = remove all demo data on boot · false = leave alone
# Same by hand: php artisan neaby:demo seed | php artisan neaby:demo wipe
NEABY_SEED_DEMO=false
# Demo photos are downloaded once at seed time (~10 MB, Pexels CDN); false = offline placeholders
NEABY_DEMO_PHOTOS=true

# ── AI listing titles (optional; works without a key) ──
# fake = built-in heuristic titles · openai = any OpenAI-compatible API · null = off
LISTING_AI_DRIVER=fake
LISTING_AI_BASE_URL=https://api.openai.com/v1
LISTING_AI_API_KEY=
LISTING_AI_MODEL=gpt-4o-mini
LISTING_AI_TIMEOUT=15
# true only if LISTING_AI_MODEL can read images (listing Q&A then also sends up to 3 product photos)
LISTING_AI_VISION=false

# ── AI shopping (optional; the site works fully without these) ──
# Word tasks — plain-language search, "Ask about this item", gift plans, "What can I get?",
# voice "shop with me" — reuse the LISTING_AI_* endpoint above (RunPod in production; needs
# LISTING_AI_DRIVER=openai + LISTING_AI_API_KEY). Never called by the For You feed or on keystrokes.
NEABY_SHOPPER_AI=true
# Optional different model for shopper tasks (blank = LISTING_AI_MODEL)
NEABY_SHOPPER_AI_MODEL=
NEABY_SHOPPER_AI_TIMEOUT=12
# Image embeddings for photo search, complete-the-look and For You look-alikes:
# Replicate CLIP (clip-vit-large-patch14, 768-d). Set the token on the server only — never commit it.
# Blank = photo search hidden; everything else unchanged.
REPLICATE_API_TOKEN=
REPLICATE_CLIP_MODEL=andreasjansson/clip-features
# Optional pinned version id (blank = the model's known/latest version)
REPLICATE_CLIP_VERSION=
REPLICATE_TIMEOUT=60
# Replicate caps new/low-spend accounts at 6 prediction-creates per minute. The client paces and retries 429s.
REPLICATE_CLIP_RPM=6
# Cosine similarity a listing photo must reach to count as a photo match (0..1)
NEABY_PHOTO_MIN_SIMILARITY=0.6

# ── Payments: checkout, wallet top-ups, memberships, sponsored listings ──
# PRODUCTION: Monnify live. Set the three MONNIFY_* secrets on the server (never commit them).
# monnify = real Monnify hosted checkout · fake = no money moves (local dev / tests only)
PAYMENT_PROVIDER=monnify
# The fake TEST MODE pay page. Keep false in production.
PAYMENT_FAKE_SANDBOX=false
# Live API. For a Monnify sandbox account use https://sandbox.monnify.com
# Webhook URL to paste in the Monnify dashboard (Transaction completion): ${APP_URL}/webhooks/payments/monnify
MONNIFY_BASE_URL=https://api.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# ── Wallet (funded from neaby through the gateway; whole naira) ──
NEABY_WALLET_ENABLED=true
NEABY_WALLET_MIN_TOPUP=100
NEABY_WALLET_MAX_TOPUP=1000000
NEABY_WALLET_MAX_BALANCE=5000000

# ── Phase 2–7 feature knobs ──
NEABY_MAIL_NOTIFICATIONS=true
NEABY_CHECKOUT_ENABLED=true
NEABY_RESERVATION_MINUTES=30
NEABY_MAX_QTY_PER_ITEM=20
NEABY_MEMBERSHIP_GRACE_DAYS=3
NEABY_SUPPLIER_REQUEST_EXPIRY_DAYS=7
NEABY_MAX_RESELLER_OFFERS=200
NEABY_SPONSORED_ENABLED=true
# kobo per day (50000 = ₦500/day)
NEABY_SPONSORED_DAILY_PRICE_MINOR=50000
# at most one sponsored card per N feed items
NEABY_SPONSORED_EVERY=8
NEABY_SELLER_PRO_ENABLED=true

# ── Mail (verify email, password reset, order / membership / request notices) ──
# Works like Paddy's mail (same Coolify variables are accepted):
#   SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD (or SMTP_PASS) /
#   SMTP_SECURE / EMAIL_FROM="neaby <neaby@collab.name.ng>" — MAIL_* wins if set.
# - MAIL_MAILER unset + a host set → smtp. MAIL_MAILER=log writes to logs only.
# - TLS follows the port (like nodemailer): 465 = implicit TLS, 587/25 = STARTTLS.
#   MAIL_SCHEME / MAIL_ENCRYPTION are only consulted for other ports;
#   SMTP_SECURE=true|false forces it.
# - From falls back to the SMTP login when MAIL_FROM_ADDRESS is empty or a
#   placeholder (servers reject "sender not owned by user").
# - Connects over IPv4 first (Paddy: --dns-result-order=ipv4first); set
#   MAIL_PREFER_IPV4=false to disable.
# Verify + reset mails send immediately (no worker). Diagnose with:
#   php artisan neaby:mail-test you@example.com   (prints config, TCP check, real error)
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=mail.collab.name.ng
MAIL_PORT=587
MAIL_USERNAME=neaby@collab.name.ng
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="neaby@collab.name.ng"
MAIL_FROM_NAME="neaby"
# Seconds to wait for connect/greeting (nodemailer uses 30)
MAIL_TIMEOUT=30
MAIL_PREFER_IPV4=true

BCRYPT_ROUNDS=12
VITE_APP_NAME="${APP_NAME}"

# --- Messaging (1:1 chat: text, images, voice notes) ---
# No websocket server needed: the client polls. Images are compressed to WebP
# in the browser (max edge 1280px); voice notes are Opus ~24 kbps.
NEABY_MESSAGING_ENABLED=true
NEABY_CHAT_MAX_IMAGE_KB=1536
NEABY_CHAT_MAX_VOICE_KB=1024
NEABY_CHAT_MAX_VOICE_SECONDS=120
NEABY_CHAT_MAX_PER_MINUTE=30
# Open-thread poll interval and global "pulse" (unread + incoming calls), seconds.
NEABY_CHAT_POLL_SECONDS=4
NEABY_CHAT_PULSE_SECONDS=10

# --- Voice calls (WebRTC, HTTP-polled signalling) ---
NEABY_CALLS_ENABLED=true
# Comma-separated STUN URLs.
NEABY_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN relay (coturn) — REQUIRED in production; without it calls between strict/
# symmetric NATs (many mobile carriers, offices) fail. Set these on the server.
# Comma-separate several URLs; offer UDP + TCP (+ TLS if you run it), e.g.
#   turn:<your-turn-host>:3478?transport=udp,turn:<your-turn-host>:3478?transport=tcp,turns:<your-turn-host>:5349?transport=tcp
# Username/credential = a static user from coturn's `user=` (lt-cred-mech).
# If APP_ENV=production and this is empty, neaby logs a warning (calls still try STUN only).
NEABY_TURN_URL=
NEABY_TURN_USERNAME=
NEABY_TURN_CREDENTIAL=
# Unanswered calls are marked missed after this many seconds.
NEABY_CALL_RING_SECONDS=40

# --- Seller QR codes ---
NEABY_QR_MAX_ACTIVE_PER_STORE=100
NEABY_QR_MAX_DISCOUNT_PERCENT=90
