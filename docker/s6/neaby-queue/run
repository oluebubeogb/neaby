#!/command/with-contenv sh
# neaby queue worker (imports, notification mail). Supervised + restarted by s6.
# Disable with NEABY_RUN_WORKERS=false (e.g. if you run a separate worker container).
if [ "${NEABY_RUN_WORKERS:-true}" != "true" ]; then exec sleep infinity; fi
sleep "${NEABY_WORKER_START_DELAY:-20}"   # let the boot hook finish migrations
cd /var/www/html
exec php artisan queue:work --sleep=3 --tries=3 --timeout=300 --max-time=3600
